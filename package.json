{
  "name": "chatgpt-web-client",
  "version": "1.0.0",
  "description": "Local-first desktop AI workspace with isolated accounts and an agent gateway",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "electron": "electron .",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.mjs && node tests/parallel-desktop.mjs && node tests/agent-target-desktop.mjs && node tests/reply-routing-desktop.mjs && node tests/updates-desktop.mjs",
    "test:parallel": "node tests/parallel-desktop.mjs",
    "cli": "node --import tsx src/cli/index.ts",
    "build:agent": "node scripts/build-agent.mjs",
    "test:agent": "cd agent-cli && go test ./...",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.chenziyang.chatgptwebclient",
    "productName": "ChatGPT Web Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "src/renderer/public/brand/workspace.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "extraFiles": [
        {
          "from": "dist-agent/chatgpt-agent.exe",
          "to": "chatgpt-agent.exe"
        }
      ],
      "icon": "src/renderer/public/brand/workspace.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "src/renderer/public/brand/workspace.png",
      "target": "AppImage",
      "category": "Utility"
    },
    "artifactName": "ChatGPT-Web-Client-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chenziyang110/ChatGPT-Web-Client.git"
  },
  "author": "ChatGPT Web Client contributors"
}
