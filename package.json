{
  "name": "chatgpt-web-client",
  "version": "1.4.4",
  "description": "Local-first desktop AI workspace with isolated accounts and an agent gateway",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "desktopName": "com.chenziyang.chatgptwebclient.desktop",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "electron": "electron .",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node --test tests/release-manifest.test.mjs",
    "test:desktop": "node tests/page-operation-desktop.mjs && node tests/reply-error-desktop.mjs && node tests/duplicate-conversation-desktop.mjs && node tests/preview-desktop.mjs && node tests/conversation-queue-desktop.mjs && node tests/desktop.mjs && node tests/clipboard-desktop.mjs && node tests/memory-desktop.mjs && node tests/parallel-desktop.mjs && node tests/agent-target-desktop.mjs && node tests/reply-routing-desktop.mjs && node tests/updates-desktop.mjs && node tests/update-install-desktop.mjs",
    "test:parallel": "node tests/parallel-desktop.mjs",
    "cli": "node --import tsx src/cli/index.ts",
    "build:agent": "node scripts/build-agent.mjs",
    "test:agent": "cd agent-cli && go test ./...",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "build:agent:all": "node scripts/build-agent.mjs --all",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never && electron-builder --win --arm64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "com.chenziyang.chatgptwebclient",
    "productName": "ChatGPT Web Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://github.com/chenziyang110/ChatGPT-Web-Client/releases/latest/download/"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "binaries": [
        "Contents/Resources/agent/chatgpt-agent"
      ],
      "icon": "src/renderer/public/brand/workspace.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "dist-agent/darwin-${arch}/",
          "to": "agent",
          "filter": [
            "chatgpt-agent"
          ]
        }
      ]
    },
    "win": {
      "icon": "src/renderer/public/brand/workspace.ico",
      "target": "nsis",
      "extraResources": [
        {
          "from": "dist-agent/win32-${arch}/",
          "to": "agent",
          "filter": [
            "chatgpt-agent.exe"
          ]
        }
      ]
    },
    "linux": {
      "icon": "src/renderer/public/brand/workspace.png",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "dist-agent/linux-${arch}/",
          "to": "agent",
          "filter": [
            "chatgpt-agent"
          ]
        }
      ]
    },
    "artifactName": "ChatGPT-Web-Client-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/before-pack.cjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "2.3.7",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chenziyang110/ChatGPT-Web-Client.git"
  },
  "author": "ChatGPT Web Client contributors"
}
